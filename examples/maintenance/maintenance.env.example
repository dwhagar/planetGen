# examples/maintenance/maintenance.env.example
#
# Template for /etc/planetgen/maintenance.env, read by both
# planetgen-orbits@.service's and planetgen-update.service's
# `EnvironmentFile=` (the latter needs it for install.sh's
# `src/migrateDb.py` step). Only needed if any value differs from
# updateOrbits.py's/stellarObjects._db.MySQLConfig's own built-in
# defaults (127.0.0.1:3306, user/database "planetgen").
#
# Copied into place (and given 600 permissions, since it holds a
# password) by install-maintenance-timer.sh -- edit the copy at
# /etc/planetgen/maintenance.env, not this file.
#
# Needs a read-write account, same as sectorGen.py/systemGen.py use --
# NOT queryDb.py's read-only one, since updateOrbits.py mutates rows.
# PLANETGEN_MYSQL_DATABASE is deliberately left unset here: the timer
# instance name supplies it (see planetgen-orbits@.service), so setting
# it here would just be overridden per-instance anyway.

PLANETGEN_MYSQL_HOST=127.0.0.1
PLANETGEN_MYSQL_PORT=3306
PLANETGEN_MYSQL_USER=planetgen
PLANETGEN_MYSQL_PASSWORD=changeme
