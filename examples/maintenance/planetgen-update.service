# examples/maintenance/planetgen-update.service
#
# Runs `update.sh` (git pull, then checks that every package, directory
# and permission the site needs is present, installing only what's
# missing, plus a `planetgen.cli.migrate` schema check) unattended -- the same
# thing a human would run by hand per README.md's "Web Interface"
# section, on a schedule instead of "whenever someone remembers to." See
# update.sh's own header comment: nothing is reinstalled, so most months
# this is cheap. Not
# templated (unlike planetgen-orbits@.service): update.sh operates on the
# whole checkout, not a single database, so one run covers every database
# this deployment serves.
#
# Paired with planetgen-orbits@.service via planetgen-update.timer/
# planetgen-orbits@.timer's fixed (not randomized) schedule times -- see
# those files' own comments for why the ordering matters: update.sh can
# change the very code planetgen.cli.orbits runs.
#
# NOTE on what this means: enabling this timer means whatever is on the
# tracked branch's remote gets pulled and deployed automatically, once a
# month, with no human review in between. update.sh itself still refuses
# to run over uncommitted local changes or a diverged/detached HEAD (see
# its own header comment) rather than forcing past either, but it does
# not gate on *what* the pull brings in. install.sh and update.sh install the timer (OPS.110) and leave it off, saying at every deploy while it is off how to turn it on:
# `sudo systemctl enable --now planetgen-update.timer` (running install-maintenance-timer.sh does the same). If this deployment's branch
# should only ever be updated by a human running `sudo ./update.sh` deliberately, do nothing: a deploy never turns it on.
# (install-maintenance-timer.sh --skip-update-timer leaves it out of a host that does not have it yet.)
#
# SEC.43: planetgen-update.path also starts this unit, when the admin Update button drops the request file
# (<state folder>/update.request). ExecStartPre removes the request before update.sh runs, so one press is one run; a press made
# while the update runs waits for it and runs after. The file's contents are never read, and ExecStart takes no argument from it.
#
# Installed by install.sh and update.sh, rendered for the real checkout and virtual environment (and by
# examples/maintenance/install-maintenance-timer.sh, which also sets up the credentials file this unit reads, needed for
# install.sh's `planetgen.cli.migrate` step).

[Unit]
Description=planetGen deployment update (git pull + dependency check)
After=network-online.target
Wants=network-online.target
# A request file that cannot be removed fails ExecStartPre at once and would start this again over and over; ten starts in ten
# minutes stop that loop (`systemctl reset-failed planetgen-update.service` clears it).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=oneshot
# Matches the deployment layout examples/apache/planetgen.conf.example
# documents (this repo checked out at /var/lib/planetGen) -- change if
# deployed elsewhere. update.sh itself resolves its own paths from
# $BASH_SOURCE regardless, but this also has to be where update.sh (and
# the git checkout it pulls into) actually lives.
WorkingDirectory=/var/lib/planetGen
# Read-write MySQL credentials -- needed for install.sh's
# `planetgen.cli.migrate` step, same file planetgen-orbits@.service reads.
# "-" prefix makes it optional so a missing file falls back to
# planetgen.cli.migrate's own built-in defaults rather than failing to start.
EnvironmentFile=-/etc/planetgen/maintenance.env
# With work running (a Generate job, a queued run, an orbital update) and no
# terminal to ask on, update.sh refuses and changes nothing (OPS.53), so this
# unit fails that month and the next firing tries again. To cancel the work
# instead, add `--yes`: ExecStart=/var/lib/planetGen/update.sh --yes (that also applies to the Update button's runs)
ExecStartPre=/bin/rm -f -- /var/lib/planetGen/state/update.request
ExecStart=/var/lib/planetGen/update.sh
