# examples/apache/planetgen.conf.example
#
# Example Apache2 virtual host for the planetGen database browser
# (docs/html-interface.md documents the application itself) and the
# read-only JSON API (docs/api.md) that now lives alongside it under the
# same DocumentRoot. Copy this file to
# /etc/apache2/sites-available/planetgen.conf, edit ServerName/logging as
# needed, then enable it:
#
#   sudo a2enmod cgid wsgi
#   sudo a2ensite planetgen
#   sudo systemctl reload apache2
#
# `cgid` (the threaded MPM-safe CGI module) is preferred over the older
# `cgi` module; either works, but `cgid` is required if apache2 is running
# mpm_event or mpm_worker (the Ubuntu default), since plain `mod_cgi` only
# supports mpm_prefork. `wsgi` (`libapache2-mod-wsgi-py3` on Debian/
# Ubuntu) serves the API (`html/wsgi.py`) -- skip that module and the
# WSGIScriptAlias block below if you only want the CGI browser.
#
# Expected layout on the server (see the repo's set-permissions.sh, which
# assumes this same layout):
#
#   /var/lib/planetGen/
#     src/html/  -- this vhost's DocumentRoot (the repo's src/html/
#                   directory), api/ included (moved there from src/api/
#                   so the API deploys from the same tree instead of a
#                   second location)
#     src/, ...  -- the rest of the repo checkout (src/stellarObjects/ in
#                   particular), so src/html/'s scripts can import the
#                   planetGen package without a separate `pip install`
#
# The database itself is a MySQL server, not a local file under this
# layout (TODO.md Phase 5) -- point the CGI scripts and the API at it with
# the PLANETGEN_MYSQL_* SetEnv directives below.
#
# /api/ (mod_wsgi): every page under html/ now fetches its data from the
# planetGen API (docs/api.md) instead of querying MySQL directly (see
# docs/html-interface.md) -- PLANETGEN_API_BASE_URL (default
# "http://127.0.0.1/api", i.e. this same vhost) is where each CGI script
# looks for it; no override needed for the common case of API and browser
# sharing one vhost the way this example does. WSGIScriptAlias below
# mounts html/wsgi.py's `application` at /api/, in its own daemon process
# (WSGIDaemonProcess) rather than Apache's embedded/shared-process mode,
# for the same isolation a real deployment wants regardless of where the
# API's own source happens to live. Needs `a2enmod wsgi`.

<VirtualHost *:80>
    ServerName planetgen.example.com
    DocumentRoot /var/lib/planetGen/src/html

    # Tell the CGI scripts which MySQL server/account to use. Only needed
    # if any differs from stellarObjects._db.MySQLConfig's own defaults
    # (127.0.0.1:3306, user/database "planetgen"). Use a SELECT-only
    # database account here -- neither the web interface nor the API's
    # read endpoints ever write (see docs/api.md's "Write endpoints" --
    # those are stubs today regardless of account).
    #
    # This only configures the CGI browser above, NOT the mod_wsgi API
    # below: mod_cgi(d) copies SetEnv values into each CGI script's real
    # process environment, but mod_wsgi only exposes them through the
    # per-request WSGI `environ` dict, never `os.environ` -- and
    # html/api/config.py reads PLANETGEN_MYSQL_* from `os.environ` once,
    # at process startup, before any request (and its `environ` dict) has
    # ever existed. To point the API at a different database, export the
    # same variables in the Apache service's own process environment
    # instead (e.g. `/etc/apache2/envvars`, or an `Environment=` line on
    # the apache2 systemd unit) -- every mod_wsgi interpreter inherits
    # that, unlike SetEnv.
    # SetEnv PLANETGEN_MYSQL_HOST db.example.com
    # SetEnv PLANETGEN_MYSQL_PORT 3306
    # SetEnv PLANETGEN_MYSQL_USER planetgen_readonly
    # SetEnv PLANETGEN_MYSQL_PASSWORD changeme
    # SetEnv PLANETGEN_MYSQL_DATABASE_PREFIX planetgen
    #
    # NOTE: none of the SetEnv lines on this page reach the mod_wsgi API
    # below (see the WSGIScriptAlias block's own comment) -- set every
    # PLANETGEN_* variable (including the two below) in Apache's own
    # process environment instead (e.g. /etc/apache2/envvars) for the API
    # to see it at all.
    #
    # A separate, write-capable (INSERT/UPDATE/DELETE, not CREATE/DROP)
    # account for the API's write endpoints (sector/system create/update/
    # delete, and everything under /api/auth/) -- see
    # docs/apache-deployment.md#mysql-accounts. Falls back to
    # PLANETGEN_MYSQL_* above when unset.
    # SetEnv PLANETGEN_MYSQL_WRITE_USER planetgen_write
    # SetEnv PLANETGEN_MYSQL_WRITE_PASSWORD changeme
    #
    # The control schema (admin logins/sessions/API keys/audit log) --
    # defaults to "planetgen_control" if unset.
    # SetEnv PLANETGEN_CONTROL_DATABASE planetgen_control

    <Directory /var/lib/planetGen/src/html>
        Options +ExecCGI -Indexes
        AddHandler cgi-script .py
        DirectoryIndex index.py
        Require all granted
    </Directory>

    # html/wsgi.py isn't a CGI script -- it's mounted at /api below via
    # WSGIScriptAlias, which takes priority for that URL prefix, but a
    # direct request for /wsgi.py would still fall through to the
    # <Directory html> CGI handler above and try (and fail) to execute it
    # as one. Deny that path directly rather than relying on the alias
    # always winning.
    <Files "wsgi.py">
        Require all denied
    </Files>

    # html/lib/ holds shared Python modules imported by the CGI scripts,
    # not pages of their own -- deny it outright rather than relying on
    # the .py handler alone (belt-and-suspenders: a misconfigured handler
    # would otherwise let it execute, or a future non-.py file in there
    # could be served as plain text).
    <Directory /var/lib/planetGen/src/html/lib>
        Require all denied
    </Directory>

    # static/ is plain CSS/JS -- served directly, never as CGI.
    <Directory /var/lib/planetGen/src/html/static>
        Options -ExecCGI -Indexes
        Require all granted
    </Directory>

    # Mounts the Flask API (docs/api.md) at /api, handled by mod_wsgi via
    # html/wsgi.py rather than the CGI handler above -- WSGIScriptAlias
    # takes priority over the <Directory html> CGI config for this URL
    # prefix. Runs in its own daemon process (WSGIDaemonProcess), not
    # Apache's embedded/shared-process mode, for real isolation from the
    # CGI browser's own requests. html/api/ itself holds only importable
    # Python source (never requested directly), so it gets the same
    # deny-all belt-and-suspenders treatment as html/lib/ above.
    WSGIScriptAlias /api /var/lib/planetGen/src/html/wsgi.py process-group=planetgen-api application-group=%{GLOBAL}
    WSGIDaemonProcess planetgen-api processes=1 threads=5
    <Directory /var/lib/planetGen/src/html/api>
        Require all denied
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/planetgen_error.log
    CustomLog ${APACHE_LOG_DIR}/planetgen_access.log combined
</VirtualHost>

# For HTTPS, terminate TLS the usual way (e.g. `certbot --apache`) or add
# a second <VirtualHost *:443> block with SSLEngine/SSLCertificateFile
# directives and the same DocumentRoot/Directory blocks above.
