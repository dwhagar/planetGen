# examples/apache/planetgen.conf.example
#
# Example Apache2 virtual host for the planetGen web interface
# (docs/html-interface.md documents the application itself) and the JSON
# API (docs/api.md). One Flask app (html/wsgi.py) serves both; Apache
# serves only static/ itself. Copy this file to
# /etc/apache2/sites-available/planetgen.conf, edit ServerName/logging as
# needed, then enable it:
#
#   sudo a2enmod wsgi headers deflate
#   sudo a2ensite planetgen
#   sudo systemctl reload apache2
#
# `wsgi` (`libapache2-mod-wsgi-py3` on Debian/Ubuntu) runs the app.
# `headers` is needed for static/'s `Header ...` lines below (cache
# lifetime and nosniff) and `deflate` for the compression block. Both are
# usually on already in a stock Debian/Ubuntu Apache; a2enmod is a no-op
# then. No CGI module is needed any more (`a2dismod cgid` if nothing else
# on the server uses it).
#
# Expected layout on the server (see the repo's set-permissions.sh, which
# assumes this same layout):
#
#   /var/lib/planetGen/
#     src/html/  -- this vhost's DocumentRoot (the repo's src/html/
#                   directory): wsgi.py, the app's api/, web/ and lib/
#                   packages, and static/
#     src/, ...  -- the rest of the repo checkout (src/stellarObjects/ in
#                   particular), so the app can import the planetGen
#                   package without a separate `pip install`
#
# The database itself is a MySQL server (TODO.md Phase 5). The app reads
# its settings from config.json (docs/config.md) or PLANETGEN_* variables
# in Apache's own process environment -- see the NOTE below.
#
# WSGIScriptAlias below mounts html/wsgi.py's `application` at / -- the
# API under /api/ and every page everywhere else -- in its own daemon
# process (WSGIDaemonProcess) rather than Apache's embedded/shared-process
# mode. The pages call the API in-process, not over HTTP. Needs `a2enmod
# wsgi alias` (alias is on by default).

<VirtualHost *:80>
    ServerName planetgen.example.com
    DocumentRoot /var/lib/planetGen/src/html

    # Security headers (Content-Security-Policy, X-Frame-Options,
    # X-Content-Type-Options, Referrer-Policy) come from the application,
    # not from here: html/web/__init__.py's SECURITY_HEADERS for every
    # page, html/api/app.py for the API. That keeps one source per
    # response and works the same without this file. Earlier versions of
    # this example also set three of them vhost-wide with `Header always
    # set`; remove those lines from an existing site config when you
    # update it (they were duplicates, not a different policy). static/
    # below is the one place Apache adds any, since no application code
    # serves it.

    # Compress text responses (pages, API JSON, CSS/JS, the SVG favicon).
    # three.js alone drops from about 740 KB to about 190 KB on the wire.
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json image/svg+xml
    </IfModule>

    # Settings (MySQL server/account, control schema, tile cache, ...)
    # come from config.json (docs/config.md) or PLANETGEN_* variables in
    # Apache's own process environment (e.g. /etc/apache2/envvars, or an
    # `Environment=` line on the apache2 systemd unit). NOT SetEnv:
    # mod_wsgi only exposes SetEnv values through the per-request WSGI
    # `environ`, never `os.environ`, and html/api/config.py reads
    # PLANETGEN_* from `os.environ` once, at process startup. Earlier
    # versions of this example had SetEnv lines here for the CGI pages;
    # remove them from an existing site config.
    #
    # The database account needs INSERT/UPDATE/DELETE grants as well as
    # SELECT if the write endpoints and admin pages are reachable. See
    # docs/apache-deployment.md#mysql-accounts.
    #
    # The 3D Galaxy Map's tile cache (html/lib/tilecache.py) defaults to
    # /var/cache/planetgen/tiles, which install.sh/update.sh create for
    # Apache's user; set tile_cache.dir in config.json to move it, and
    # create the new directory with:
    #   sudo examples/apache/create-cache-dir.sh /path/to/tiles

    # URL routing:
    #
    #   /static/...   Apache serves the files directly (Alias below).
    #   everything else -- /, /sectors, /system/<id>, /api/..., and the
    #                 old /<name>.py page URLs (which the app answers with
    #                 a 301 to the page that replaced them) -- goes to the
    #                 Flask app (html/wsgi.py, WSGIScriptAlias / further
    #                 down).
    #
    # mod_wsgi runs its WSGIScriptAlias after mod_alias's Alias, so
    # /static/ wins for the paths it matches even though WSGIScriptAlias /
    # matches every URL. Nothing under html/ is executed or served
    # directly apart from static/.
    Alias /static/ /var/lib/planetGen/src/html/static/

    <Directory /var/lib/planetGen/src/html>
        Options -Indexes
        Require all granted
    </Directory>

    # html/lib/ and html/api/ hold only importable Python source, never
    # requested directly -- deny them outright (belt-and-suspenders: every
    # URL outside /static/ goes to the app anyway).
    <Directory /var/lib/planetGen/src/html/lib>
        Require all denied
    </Directory>
    <Directory /var/lib/planetGen/src/html/api>
        Require all denied
    </Directory>

    # static/ is plain CSS/JS/SVG -- served directly.
    #
    # Every page links its static files with `?v=<release version>`
    # (html/lib/fmt.py's `static_url`), and the map scripts pass the same
    # `?v=` on to the modules they import, so a release changes every URL.
    # That lets browsers keep a versioned file for a year without asking
    # again. A request without `?v=` (an old cached page, a hand-typed
    # URL) is revalidated every time instead, so it can never go stale.
    <Directory /var/lib/planetGen/src/html/static>
        Options -Indexes
        Require all granted
        <IfModule mod_headers.c>
            Header always set X-Content-Type-Options "nosniff"
            <If "%{QUERY_STRING} =~ /(^|&)v=/">
                Header set Cache-Control "public, max-age=31536000, immutable"
            </If>
            <Else>
                Header set Cache-Control "no-cache"
            </Else>
        </IfModule>
    </Directory>

    # The Flask app (html/wsgi.py) runs in its own daemon process
    # (WSGIDaemonProcess), not Apache's embedded/shared-process mode.
    # WSGIDaemonProcess must come before WSGIScriptAlias: mod_wsgi
    # validates that a WSGIScriptAlias's process-group=... already names a
    # declared daemon process at the point it parses that line, not by the
    # end of the file -- declaring the group after fails apache2ctl
    # configtest with "WSGI process group not yet configured".
    #
    # Keep `processes=1` unless PLANETGEN_RATELIMIT_STORAGE_URI (see
    # html/api/config.py) is also set to a shared backend (e.g.
    # redis://...): Flask-Limiter's default in-memory storage only counts
    # requests correctly within a single process, and `create_app` logs a
    # warning at startup if that assumption stops holding. `threads=5`
    # alone shares this one process's memory, so it stays accurate.
    #
    # request-timeout=60 restarts the daemon if requests run far longer
    # than any page waits for them, so a runaway request can't hold
    # threads and memory until the kernel's OOM killer takes Apache down
    # with it -- what happened on 2026-09-24 with the Galaxy Map's old
    # unbounded view query.
    #
    # python-home runs the app in planetGen's own venv, where install.sh
    # puts every library it needs; the system Python stays apt's. The
    # venv is built from the same system python3 mod_wsgi embeds, which
    # install.sh/update.sh check.
    WSGIDaemonProcess planetgen-api python-home=/opt/planetgen/venv processes=1 threads=5 request-timeout=60
    #
    # Mounted at / (not /api): the same app serves the JSON API under /api
    # and the pages everywhere else. Replace an older `WSGIScriptAlias
    # /api ...` line with this one; don't keep both.
    WSGIScriptAlias / /var/lib/planetGen/src/html/wsgi.py process-group=planetgen-api application-group=%{GLOBAL}

    ErrorLog ${APACHE_LOG_DIR}/planetgen_error.log
    CustomLog ${APACHE_LOG_DIR}/planetgen_access.log combined
</VirtualHost>

# --- HTTPS ---
# The `:80` VirtualHost above serves plain HTTP; a production deployment
# should terminate TLS in front of it rather than serve real traffic this
# way. Simplest path: `certbot --apache`, which rewrites the `:80` block
# into a redirect and generates the `:443` block for you.
#
# To do it by hand:
#
#   1. WSGIDaemonProcess is a server-wide declaration, not per-vhost --
#      move the `WSGIDaemonProcess planetgen-api ...` line above BOTH
#      VirtualHost blocks so the :443 block can reference the same
#      process group without a second, conflicting declaration. Copy
#      everything else from the :80 block above into a new
#      `<VirtualHost *:443>` block (`Alias /static/`, the <Directory>
#      blocks, `WSGIScriptAlias /`, ...), then add:
#
#        SSLEngine on
#        SSLCertificateFile /etc/letsencrypt/live/planetgen.example.com/fullchain.pem
#        SSLCertificateKeyFile /etc/letsencrypt/live/planetgen.example.com/privkey.pem
#
#   2. Replace the `:80` block's contents with a redirect:
#
#        RewriteEngine On
#        RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [R=permanent,L]
#
#      Older versions of this example excluded /api from that redirect,
#      because the CGI pages called the API over plain-HTTP loopback. The
#      pages now call it in-process, so the exclusion is no longer needed
#      (it does no harm if you keep it).
#
# Needs `a2enmod ssl rewrite` in addition to the modules enabled above.
