<!--
  examples/windows/caddy-service.xml

  WinSW service definition for Caddy (the approach Caddy's own docs
  recommend on Windows). Save WinSW 2.x as C:\srv\caddy\caddy-service.exe
  next to caddy.exe and this file, then (elevated):
      C:\srv\caddy\caddy-service.exe install
      C:\srv\caddy\caddy-service.exe start
  Caddy keeps its certificates under the service account's profile
  (%AppData%\Caddy); LocalSystem is the simple choice for ports 80/443.
-->
<service>
  <id>caddy</id>
  <name>Caddy</name>
  <description>Caddy web server (planetGen reverse proxy)</description>
  <executable>C:\srv\caddy\caddy.exe</executable>
  <arguments>run --config C:\srv\caddy\Caddyfile</arguments>
  <workingdirectory>C:\srv\caddy</workingdirectory>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
  <logpath>C:\ProgramData\planetgen\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
