<?xml version="1.0" encoding="utf-8"?>
<!--
  examples/windows/web.config

  IIS site for planetGen with HttpPlatformHandler
  (docs/deployment/windows.md, option 1). IIS starts waitress on a port it
  picks, forwards every request to it, and restarts it if it dies.
  waitress loads src\html\wsgi.py (the file Apache's mod_wsgi loads) as
  the module "wsgi", found through PYTHONPATH below.

  Layout (see windows.md):
    C:\srv\planetGen              the git checkout (like /var/lib/planetGen)
    C:\srv\planetgen-venv         Python virtual environment
    C:\srv\planetgen-site         this web.config: the IIS site's physical path
    /static  (virtual directory)  -> C:\srv\planetGen\src\html\static

  Needs: IIS with Static Content, Dynamic and Static Compression; the
  HttpPlatformHandler module (v1.2); the URL Rewrite module (for the
  HTTPS redirect and the static Cache-Control rule).

  Reproduces the Apache vhost: /static/ served by IIS itself with nosniff
  and the ?v= cache rule; everything else to the Flask app; nothing else
  in the checkout is reachable (the site root is not the checkout).
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="PlanetGenHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <!--
      requestTimeout 00:01:00 matches mod_wsgi's request-timeout=60.
      stdoutLogFile: waitress and Python startup errors. The folder must
      exist and be writable by the app pool identity.
      waitress arguments: 5 threads like the Apache daemon; keep the
      X-Forwarded-* headers (waitress deletes them by default) so the
      app's "proxy_fix" setting can read them. But see windows.md: check
      that HttpPlatformHandler sets them before you turn proxy_fix on.
    -->
    <httpPlatform processPath="C:\srv\planetgen-venv\Scripts\python.exe"
                  arguments="-m waitress --listen=127.0.0.1:%HTTP_PLATFORM_PORT% --threads=5 --no-clear-untrusted-proxy-headers --max-request-body-size=1048576 wsgi:application"
                  startupTimeLimit="60"
                  requestTimeout="00:01:00"
                  processesPerApplication="1"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\ProgramData\planetgen\logs\httpplatform">
      <environmentVariables>
        <!-- Where waitress finds wsgi.py. -->
        <environmentVariable name="PYTHONPATH" value="C:\srv\planetGen\src\html" />
        <!-- Where the NLTK 'words' corpus was downloaded (windows.md). -->
        <environmentVariable name="NLTK_DATA" value="C:\ProgramData\planetgen\nltk_data" />
        <!-- Optional PLANETGEN_* overrides (docs/config.md); config.json is the main file. -->
      </environmentVariables>
    </httpPlatform>

    <!-- The API's request bodies are small JSON documents. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
      <outboundRules>
        <!-- /static/...?v=<release>: cache a year. Without ?v=: revalidate. -->
        <rule name="Static versioned cache">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/static/" />
            <add input="{QUERY_STRING}" pattern="(^|&amp;)v=" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="Static unversioned cache">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/static/" />
            <add input="{QUERY_STRING}" pattern="(^|&amp;)v=" negate="true" />
          </conditions>
          <action type="Rewrite" value="no-cache" />
        </rule>
      </outboundRules>
    </rewrite>

  </system.webServer>

  <!-- The /static virtual directory: IIS's own static file handler, not Python. -->
  <location path="static">
    <system.webServer>
      <handlers>
        <remove name="PlanetGenHandler" />
      </handlers>
      <directoryBrowse enabled="false" />
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
      <staticContent>
        <!-- .js modules and .svg: make sure the MIME types are right. -->
        <remove fileExtension=".js" />
        <mimeMap fileExtension=".js" mimeType="text/javascript" />
        <remove fileExtension=".svg" />
        <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
