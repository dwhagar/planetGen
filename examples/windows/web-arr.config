<?xml version="1.0" encoding="utf-8"?>
<!--
  examples/windows/web-arr.config

  Alternative IIS site for planetGen: IIS as a reverse proxy (URL Rewrite
  + Application Request Routing) in front of waitress running as its own
  Windows service (planetgen-waitress.xml) on 127.0.0.1:8000. Use it
  instead of web.config when you want waitress to keep running across
  IIS app pool recycles (docs/deployment/windows.md, option 1, "ARR
  variant").
  Rename it to web.config in C:\srv\planetgen-site.

  Server-level setup, once (IIS Manager > server > Application Request
  Routing Cache > Server Proxy Settings, or appcmd):
    - Enable proxy.
    - Keep "Reverse rewrite host in response headers" off: the app sends
      relative redirects and should see the original Host.
    - Turn off "Include TCP port from client IP": with the port in
      X-Forwarded-For, every connection would get its own rate-limit
      budget.
    - Allow the server variable HTTP_X_FORWARDED_PROTO to be set
      (URL Rewrite > View Server Variables > Add).
  ARR adds X-Forwarded-For itself. config.json's "proxy_fix" should trust
  one proxy for x_for and x_proto (docs/config.md).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
    </security>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- /static/ stays with IIS (the virtual directory); everything else to waitress. -->
        <rule name="planetGen app" stopProcessing="true">
          <match url="^(?!static/)(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Static versioned cache">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/static/" />
            <add input="{QUERY_STRING}" pattern="(^|&amp;)v=" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="Static unversioned cache">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/static/" />
            <add input="{QUERY_STRING}" pattern="(^|&amp;)v=" negate="true" />
          </conditions>
          <action type="Rewrite" value="no-cache" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>

  <location path="static">
    <system.webServer>
      <directoryBrowse enabled="false" />
      <httpProtocol>
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
