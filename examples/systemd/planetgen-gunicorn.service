# examples/systemd/planetgen-gunicorn.service
#
# Runs the planetGen Flask app (every page and the API) under gunicorn,
# for nginx or Caddy to proxy to. The gunicorn equivalent of the Apache
# vhost's
#     WSGIDaemonProcess planetgen-api processes=1 threads=5 request-timeout=60
#
# gunicorn loads src/html/wsgi.py directly, the file mod_wsgi loads.
# config.json must set "proxy_fix": {"x_for": 1, "x_proto": 1} so the app
# sees the client's address and scheme, not the proxy's (docs/reference/config.md).
# See docs/deployment/nginx.md.
#
# Install (by hand: install.sh, update.sh and install-maintenance-timer.sh install the maintenance units but never this one). Copy
# it, then change the two paths that name where planetGen is installed on this host:
#     1. the checkout: /var/lib/planetGen (WorkingDirectory= and the --pythonpath line of ExecStart=)
#     2. the virtual environment: /usr/local/planetgen/venv (the gunicorn on the first line of ExecStart=; PLANETGEN_VENV)
# No change is needed when the checkout is at /var/lib/planetGen and the environment at /usr/local/planetgen/venv.
#     sudo cp examples/systemd/planetgen-gunicorn.service /etc/systemd/system/
#     sudoedit /etc/systemd/system/planetgen-gunicorn.service      # the two paths above
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now planetgen-gunicorn
#
# After `sudo ./update.sh`:   sudo systemctl reload planetgen-gunicorn
#
# reload vs restart: reload (SIGHUP) starts new workers with the new code
# and leaves a running admin Generate job alone. restart/stop end every
# process in this unit's cgroup, including a Generate job's runner (it
# was started with start_new_session=True, which leaves the process group
# but not the cgroup); the page then shows that job as "interrupted".
# Apache's own unit behaves the same way on a restart.

[Unit]
Description=planetGen web app (gunicorn)
After=network-online.target
Wants=network-online.target
# If MySQL/MariaDB runs on this host, also order after it:
# After=mariadb.service mysql.service

[Service]
# gunicorn tells systemd when it is ready. If your gunicorn is too old to
# do that (the unit then times out on start), use Type=simple instead.
Type=notify
NotifyAccess=main
# The same identity install.sh/update.sh give the runtime directories to
# (they detect Apache's user and fall back to www-data when Apache is
# not installed). The checkout belongs to root with the web group (set-permissions.sh, SEC.37); the venv stays root's.
User=www-data
Group=www-data
WorkingDirectory=/var/lib/planetGen
# config.json at the repo root is the main configuration. Optional
# per-process overrides (PLANETGEN_* variables, see docs/reference/config.md) go in
# this file, mode 640 root:www-data. The leading "-" makes it optional.
EnvironmentFile=-/etc/planetgen/web.env

# /run/planetgen/ for the socket nginx/Caddy connect to.
RuntimeDirectory=planetgen
RuntimeDirectoryMode=0750

# One process, five threads: the same shape as the Apache daemon. The rate
# limits and login lockouts count on the Redis server in redis.url
# (ratelimit.storage_uri empty, the default), so they stay correct with
# more than one worker; "memory://" counts per process and is right only
# with exactly one (docs/reference/api.md, "Rate limiting").
#
# --timeout is gunicorn's worker heartbeat, not a per-request limit: with
# threads, one slow request does not trip it. The per-request limit is
# the proxy's (proxy_read_timeout 60s in the nginx example).
#
# gunicorn comes from planetGen's own virtual environment (OPS.45;
# scripts/install-python-deps.sh makes it from requirements-server.lock,
# which pins gunicorn 25.1 or later), not from apt. 25.1 and later want
# --no-control-socket: the control socket (for the gunicornc tool, unused
# here) tries to create ~/.gunicorn in www-data's home, and in 25.1-26.x
# leaks a thread and a file descriptor on every reload
# (benoitc/gunicorn#3648).
ExecStart=/usr/local/planetgen/venv/bin/gunicorn \
    --pythonpath /var/lib/planetGen/src/html \
    --no-control-socket \
    --bind unix:/run/planetgen/gunicorn.sock \
    --umask 0007 \
    --workers 1 \
    --worker-class gthread \
    --threads 5 \
    --timeout 60 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile - \
    wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure

# Hardening. ProtectSystem=full makes /usr, /boot and /etc read-only for
# this service and the Generate jobs it starts; /var stays governed by
# ordinary file permissions (the tile cache, the jobs directory and the
# debug log belong to www-data, the code tree does not). /tmp is a
# private one.
#
# SEC.42: the kernel, the control groups, other users' views and odd socket types are closed to the service too. The
# address families are the ones it uses: UNIX (the proxy socket, a local MySQL or Redis socket), IPv4 and IPv6 (MySQL,
# Redis, DNS) and NETLINK (name lookups). No MemoryDenyWriteExecute: numpy and the compiled libraries need it off.
# ReadWritePaths is not set because ProtectSystem=full leaves /var alone; an operator who wants "strict" lists the
# folders config.json names (jobs.dir, tile_cache.dir, log_dir, log_file) plus the state folder:
#     ProtectSystem=strict
#     ReadWritePaths=/var/lib/planetGen/state /var/lib/planetGen/jobs /var/cache/planetgen /var/log
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
