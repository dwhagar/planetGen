{
  "config_version": 1,
  "site_name": "planetGen",
  "base_url": "http://localhost/",
  "api_base_url": "http://127.0.0.1/api",
  "debug": false,
  "log_file": "/var/log/planetgen.log",
  "log_dir": "",
  "log_rotation": "auto",
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "planetgen",
    "password": "",
    "database": "planetgen",
    "database_prefix": "planetgen",
    "statement_timeout_seconds": 10.0
  },
  "control_database": "planetgen_control",
  "redis": {
    "url": "redis://127.0.0.1:6379/0"
  },
  "ratelimit": {
    "default": "200 per day;50 per hour",
    "storage_uri": "",
    "pages": {
      "search": "30 per minute",
      "galaxy": "60 per minute",
      "galaxy_tiles": "600 per minute",
      "health": "60 per minute",
      "other": "300 per minute"
    }
  },
  "login_allowlist": [],
  "admin_cookie_insecure": false,
  "secret_key": "",
  "proxy_fix": {
    "x_for": 0,
    "x_proto": 0,
    "x_host": 0
  },
  "tile_cache": {
    "dir": "",
    "max_mb": 200.0
  },
  "page_cache": {
    "enabled": true,
    "max_entries": 2000,
    "max_mb": 64.0,
    "stamp_seconds": 15.0,
    "max_age_seconds": 300.0,
    "stored_counts": true
  },
  "jobs": {
    "dir": "",
    "keep": 20,
    "python": ""
  },
  "wiki": {
    "wikijs": {
      "base_url": "",
      "api_token": ""
    },
    "mediawiki": {
      "base_url": "",
      "username": "",
      "password": ""
    }
  }
}
