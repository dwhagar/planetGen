{
  "site_name": "planetGen",
  "base_url": "http://localhost/",
  "api_base_url": "http://127.0.0.1/api",
  "debug": false,
  "log_file": "/var/log/planetgen.log",
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "planetgen",
    "password": "",
    "database": "planetgen",
    "database_prefix": "planetgen"
  },
  "control_database": "planetgen_control",
  "ratelimit": {
    "default": "200 per day;50 per hour",
    "storage_uri": "memory://",
    "pages": {
      "search": "30 per minute",
      "galaxy": "60 per minute",
      "galaxy_tiles": "600 per minute",
      "health": "60 per minute",
      "other": "300 per minute"
    }
  },
  "admin_cookie_insecure": false,
  "secret_key": "",
  "proxy_fix": {
    "x_for": 0,
    "x_proto": 0,
    "x_host": 0
  },
  "tile_cache": {
    "dir": "",
    "max_mb": 200
  },
  "jobs": {
    "dir": "",
    "keep": 20,
    "python": ""
  },
  "wiki": {
    "wikijs": {
      "base_url": "",
      "api_token": ""
    },
    "mediawiki": {
      "base_url": "",
      "username": "",
      "password": ""
    }
  }
}
