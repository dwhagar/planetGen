{
  "config_version": 1,
  "site_name": "planetGen",
  "base_url": "http://localhost/",
  "api_base_url": "http://127.0.0.1/api",
  "debug": false,
  "log_file": "/var/log/planetgen.log",
  "log_dir": "",
  "log_rotation": "auto",
  "settings": {
    "backups_kept": 20
  },
  "site": {
    "tagline": "",
    "language": "en"
  },
  "web": {
    "title_template": "{title} - {site_name}",
    "theme_color_light": "#f6f7fb",
    "theme_color_dark": "#14151e",
    "assets_dir": ""
  },
  "icons": {
    "favicon_svg": "",
    "favicon_png": "",
    "apple_touch_icon": "",
    "manifest_enabled": false
  },
  "seo": {
    "indexing": "top_pages",
    "detail_pages": "noindex",
    "description": "",
    "keywords": [],
    "json_ld": true,
    "robots_extra": "",
    "robots_override": "",
    "block_ai_crawlers": false,
    "sitemap_enabled": true,
    "sitemap_max_urls": 50000,
    "sitemap_cache_hours": 24,
    "security_txt": "",
    "humans_txt": "",
    "privacy_note": ""
  },
  "og": {
    "enabled": true,
    "site_name": "",
    "image_alt": "",
    "default_image": "",
    "twitter_card": "summary_large_image",
    "twitter_site": "",
    "generated_cards": false,
    "card_cache_mb": 100.0,
    "card_cache_dir": ""
  },
  "mysql": {
    "host": "127.0.0.1",
    "port": 3306,
    "user": "planetgen",
    "password": "",
    "database": "planetgen",
    "database_prefix": "planetgen",
    "statement_timeout_seconds": 10.0
  },
  "control_database": "planetgen_control",
  "redis": {
    "url": "redis://127.0.0.1:6379/0"
  },
  "ratelimit": {
    "default": "200 per day;50 per hour",
    "storage_uri": "",
    "pages": {
      "search": "30 per minute",
      "galaxy": "60 per minute",
      "galaxy_tiles": "600 per minute",
      "health": "60 per minute",
      "other": "300 per minute"
    }
  },
  "login_allowlist": [],
  "admin_cookie_insecure": false,
  "secret_key": "",
  "proxy_fix": {
    "x_for": 0,
    "x_proto": 0,
    "x_host": 0
  },
  "cache": {
    "max_mb": 1024.0
  },
  "tile_cache": {
    "dir": "",
    "warm_levels": 8,
    "warm_zoom_levels": 14,
    "prefetch_per_visit": 128,
    "prefetch_per_minute": 600,
    "prefetch_max_queued": 8
  },
  "page_cache": {
    "enabled": true,
    "max_entries": 2000,
    "max_mb": 64.0,
    "stamp_seconds": 15.0,
    "max_age_seconds": 300.0,
    "shared_seconds": 21600.0,
    "warm_max_objects": 5000,
    "stored_counts": true
  },
  "jobs": {
    "dir": "",
    "keep": 20,
    "python": ""
  },
  "wiki": {
    "wikijs": {
      "base_url": "",
      "api_token": ""
    },
    "mediawiki": {
      "base_url": "",
      "username": "",
      "password": ""
    }
  }
}
