          "x-category": "cache",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false,
          "x-unit": "objects"
        }
      },
      "title": "PageCache",
      "type": "object"
