          "type": "boolean",
          "x-category": "cache",
          "x-editable": true,
          "x-env": "PLANETGEN_COUNT_CACHE",
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        },
        "warm_max_objects": {
          "default": 5000,
          "description": "Most sector pages, system pages and phenomenon pages the warm-up builds (each, nearest the galaxy centre first); the rest are built on their first visit, and the warm-up says how many it left out.",
