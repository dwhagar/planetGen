          "x-multiline": false,
          "x-restart": true,
          "x-secret": false
        },
        "max_mb": {
          "default": 64,
          "description": "Most memory the answers may take.",
          "exclusiveMinimum": 0,
          "title": "Max Mb",
          "type": "number",
          "x-category": "cache",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": true,
          "x-secret": false,
          "x-unit": "MB"
        },
        "shared_seconds": {
          "default": 21600,
          "description": "How long an answer is kept in Redis, where every web process and the warm-up share it. Each answer is served only while the data it read has not changed, so this only bounds the memory.",
          "exclusiveMinimum": 0,
          "title": "Shared Seconds",
          "type": "number",
          "x-category": "cache",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": true,
          "x-secret": false,
          "x-unit": "seconds"
        },
        "stamp_seconds": {
          "default": 15,
          "description": "How often the galaxy's content stamp is checked.",
          "minimum": 0,
          "title": "Stamp Seconds",
          "type": "number",
          "x-category": "cache",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": true,
          "x-secret": false,
          "x-unit": "seconds"
        },
        "stored_counts": {
          "default": true,
