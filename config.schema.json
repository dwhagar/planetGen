          "x-multiline": false,
          "x-restart": true,
          "x-secret": false
        },
        "host": {
          "default": "127.0.0.1",
          "description": "The MySQL server's host name or address.",
          "title": "Host",
          "type": "string",
          "x-category": "database",
          "x-editable": false,
          "x-env": "PLANETGEN_MYSQL_HOST",
          "x-env-empty": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": true,
          "x-secret": false
        },
        "password": {
          "default": "",
          "description": "That account's password.",
          "title": "Password",
          "type": "string",
          "x-category": "database",
          "x-editable": false,
          "x-env": "PLANETGEN_MYSQL_PASSWORD",
          "x-env-empty": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": true,
          "x-secret": true
        },
        "port": {
          "default": 3306,
          "description": "The server's port.",
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer",
          "x-category": "database",
          "x-editable": false,
          "x-env": "PLANETGEN_MYSQL_PORT",
          "x-env-empty": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": true,
          "x-secret": false
        },
        "statement_timeout_seconds": {
          "default": 10,
          "description": "The longest any statement on the web interface's and API's read-only connections may run (0 turns the limit off). A query it stops gives a 504 page, or a QUERY_TIMEOUT error from the API.",
          "minimum": 0,
          "title": "Statement Timeout Seconds",
          "type": "number",
          "x-category": "database",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false,
          "x-unit": "seconds"
        },
        "user": {
          "default": "planetgen",
          "description": "The account every entry point connects with; give it whatever grants the most demanding caller needs.",
          "title": "User",
          "type": "string",
          "x-category": "database",
          "x-editable": false,
          "x-env": "PLANETGEN_MYSQL_USER",
          "x-env-empty": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": true,
          "x-secret": false
        }
      },
      "title": "MySQL",
      "type": "object"
    },
