{
  "$defs": {
    "Cache": {
      "properties": {
        "max_mb": {
          "default": 1024,
          "description": "How much disk the site's stored caches (today the Galaxy Map's tiles) may use, in all. When it is full the warm-up stops, the tiles it built ahead stay, and the tiles a visit asked for are dropped, the least recently visited first (0 turns the disk caches off).",
          "minimum": 0,
          "title": "Max Mb",
          "type": "number",
          "x-category": "cache",
          "x-editable": true,
          "x-env": "PLANETGEN_CACHE_MAX_MB",
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false,
          "x-unit": "MB"
        },
        "warm_on_change": {
          "default": true,
          "description": "Start the warm-up by itself after anything that changes what the site shows (a generation run, the orbital update, an edit), so the caches are rebuilt without waiting for the next update. It rebuilds only what the change touched.",
          "title": "Warm On Change",
          "type": "boolean",
          "x-category": "cache",
          "x-editable": true,
          "x-env": "PLANETGEN_WARM_ON_CHANGE",
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        },
        "warm_settle_seconds": {
          "default": 60,
          "description": "How long the automatic warm-up waits after the first change before it starts, so a burst of edits is one warm-up and not one for each.",
          "minimum": 0,
          "title": "Warm Settle Seconds",
          "type": "number",
          "x-category": "cache",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false,
          "x-unit": "seconds"
        }
      },
      "title": "Cache",
      "type": "object"
    },
    "Icons": {
      "properties": {
        "apple_touch_icon": {
          "default": "",
          "description": "The 180 by 180 PNG iPhones and iPads use for a home-screen bookmark. Set it by uploading on the Images page.",
          "title": "Apple Touch Icon",
          "type": "string",
          "x-category": "icons",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        },
        "favicon_png": {
          "default": "",
          "description": "A PNG or ICO icon for browsers that do not take an SVG; empty offers none. Set it by uploading on the Images page.",
          "title": "Favicon Png",
          "type": "string",
          "x-category": "icons",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        },
        "favicon_svg": {
          "default": "",
          "description": "The site icon as an uploaded SVG; empty uses the built-in one. Set it by uploading on the Images page.",
          "title": "Favicon Svg",
          "type": "string",
          "x-category": "icons",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        },
        "manifest_enabled": {
          "default": false,
          "description": "Serve /site.webmanifest, which names the site, its icon and its theme colour for browsers that can install it.",
          "title": "Manifest Enabled",
          "type": "boolean",
          "x-category": "icons",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        }
      },
      "title": "Icons",
      "type": "object"
    },
    "Jobs": {
      "properties": {
        "dir": {
          "default": "",
          "description": "Where each background job's command lines, status and output are kept; empty means /var/lib/planetGen/jobs.",
          "title": "Dir",
          "type": "string",
          "x-category": "jobs",
          "x-editable": false,
          "x-env": "PLANETGEN_JOBS_DIR",
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        },
        "keep": {
          "default": 20,
          "description": "How many finished jobs are kept.",
          "minimum": 1,
          "title": "Keep",
          "type": "integer",
          "x-category": "jobs",
          "x-editable": true,
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        },
        "python": {
          "default": "",
          "description": "The interpreter that runs planetgen and planetgen.cli.reset for the jobs; empty means the web app's own Python. Editing it from the web would be code execution, so it is file-only.",
          "title": "Python",
          "type": "string",
          "x-category": "jobs",
          "x-editable": false,
          "x-env": "PLANETGEN_PYTHON",
          "x-min_role": "admin",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        }
      },
      "title": "Jobs",
      "type": "object"
    },
    "MediaWiki": {
      "properties": {
        "base_url": {
          "default": "",
