          "x-restart": false,
          "x-secret": false
        },
        "password": {
          "default": "",
          "description": "That Bot Password.",
          "title": "Password",
          "type": "string",
          "x-category": "wiki",
          "x-editable": true,
          "x-env": "PLANETGEN_MEDIAWIKI_PASSWORD",
          "x-min_role": "owner",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": true
        },
        "username": {
          "default": "",
          "description": "A Bot Password user name, in User@BotName form.",
          "title": "Username",
          "type": "string",
          "x-category": "wiki",
          "x-editable": true,
          "x-env": "PLANETGEN_MEDIAWIKI_USERNAME",
          "x-min_role": "owner",
          "x-multiline": false,
          "x-restart": false,
          "x-secret": false
        }
      },
      "title": "MediaWiki",
      "type": "object"
    },
    "MySQL": {
      "properties": {
        "database": {
          "default": "planetgen",
          "description": "The galaxy database the pages show and the generators fill.",
          "title": "Database",
          "type": "string",
