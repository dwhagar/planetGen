{
  "title": "Planet and moon classes as percent matches: every class's own positive conditions (GEN.1205)",
  "version": 2,
  "status": "design (GEN.1205): read by nothing in the app yet. physics/class_fit.py loads and checks it; the shadow scorer (GEN.1206) and the best-fit classifier (GEN.1207) read it. planet_classes.json still decides every stored letter.",
  "how": "A class is described by its own conditions; no row relies on an earlier row having said no. `air` is a hard gate (true: pressure 10 Pa or more; false: under 10 Pa; null: giants). `kind` t or g is a hard gate. Every condition is graded: membership 1 inside the edge and a linear fall to 0 across the shoulder beyond it (`shoulders`, per quantity). The class match is the geometric mean of its conditions' memberships; the best match wins; a tie goes to the class with more conditions, then to the letter.",
  "gate_pressure_pa": 10.0,
  "shoulders": {
    "mass_earth": {
      "relative": 0.4,
      "basis": "CF1"
    },
    "gravity_g": {
      "relative": 0.1,
      "basis": "CF2"
    },
    "temperature_k": {
      "absolute": 10.0,
      "basis": "CF3"
    },
    "pressure_pa": {
      "relative": 0.3,
      "basis": "CF4"
    },
    "ocean_fraction": {
      "absolute": 0.05,
      "basis": "CF5"
    },
    "water_mass_fraction": {
      "relative": 0.5,
      "basis": "CF6"
    },
    "share_o2": {
      "relative": 0.25,
      "floor": 0.005,
      "basis": "CF7"
    },
    "share_co2": {
      "relative": 0.25,
      "floor": 0.002,
      "basis": "CF7"
    },
    "share_h2": {
      "relative": 0.25,
      "floor": 0.005,
      "basis": "CF7"
    },
    "share_so2": {
      "relative": 0.25,
      "floor": 0.002,
      "basis": "CF7"
    },
    "reducing_share": {
      "relative": 0.25,
      "floor": 0.005,
      "basis": "CF7"
    },
    "hottest_region_k": {
      "absolute": 5.0,
      "basis": "DM1"
    },
    "coldest_region_k": {
      "absolute": 5.0,
      "basis": "DM1"
    },
    "day_temperature_k": {
      "absolute": 5.0,
      "basis": "DM1"
    },
    "night_temperature_k": {
      "absolute": 5.0,
      "basis": "DM1"
    },
    "wet_bulb_c": {
      "absolute": 3.0,
      "basis": "DM2"
    },
    "relative_humidity": {
      "absolute": 0.1,
      "basis": "DM3"
    },
    "share_ch4": {
      "relative": 0.25,
      "floor": 0.005,
      "basis": "CF7"
    },
    "ammonia_water_mass_fraction": {
      "absolute": 0.03,
      "basis": "DM8"
    }
  },
  "shoulder_note": "relative: the shoulder is that share of the edge value (at least `floor` when given); absolute: the shoulder in the quantity's own unit. A shoulder of zero would make a hard edge.",
